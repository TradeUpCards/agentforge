# OpenEMR Patient Dashboard — environment template
# Copy to .env (gitignored) and fill in the values from your OAuth2 client registration.

# Base URL of the OpenEMR install (no trailing slash).
VITE_OPENEMR_BASE_URL=https://localhost:9300

# OAuth2 client_id, returned from POST /oauth2/default/registration.
VITE_CLIENT_ID=

# OAuth2 client_secret. OpenEMR requires confidential clients for user/ scopes
# (see §5 of PATIENT_DASHBOARD_MIGRATION.md for the tradeoff). PKCE is what
# actually protects the auth code; the secret only stops a confused-deputy
# attack at the token endpoint.
VITE_CLIENT_SECRET=

# Must match a redirect_uri registered with the OAuth2 client.
VITE_REDIRECT_URI=http://localhost:5173/callback
VITE_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
