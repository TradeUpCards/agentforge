# Deploy target for `scripts/deploy-to-droplet.sh`.
#
# Copy to `.env.deploy` and fill in the actual values. The `.env.deploy`
# file is gitignored — never commit credentials or hostnames.
#
# Used by deploy-to-droplet.sh; not consumed by Vite at build time.
# (Build-time values live in `../.env.production`.)

# SSH target — must be reachable via the operator's existing
# ssh-agent / ~/.ssh/config. The script does not embed secrets.
# Format: "user@host" (e.g. "deploy@agentforge.example.com").
DROPLET_SSH_TARGET=

# OpenEMR docroot on the droplet — the script writes to
# ${DROPLET_DOCROOT}/patient-dashboard/. Trailing slash optional.
# Standard OpenEMR Flex image: /var/www/localhost/htdocs/openemr
DROPLET_DOCROOT=
