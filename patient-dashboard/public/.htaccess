# SPA-routing fallback for the React patient dashboard.
#
# Without this, hitting `https://<host>/dashboard-app/dashboard/abc-123`
# directly returns 404 because Apache looks for a file at that path. With
# this rule, every non-file/non-directory request falls back to the SPA's
# `index.html`, which lets React Router pick up the route on the client.
#
# Requires `AllowOverride All` (or at least `AllowOverride FileInfo`) on
# the directory in OpenEMR's Apache config — the default OpenEMR Docker
# image grants this on the docroot, but verify on a custom-configured
# droplet.
#
# This file is in `patient-dashboard/public/` so Vite copies it into
# `dist/` on every build, alongside index.html, with no extra deploy step.
#
# Note: the deploy path is `/dashboard-app/` (a sibling of the
# `/patient-dashboard/` source directory at OpenEMR's docroot). Keeping
# the build output and the source tree separate avoids the source-code-
# exposure issue you'd otherwise hit by deploying into the source dir.

# `Options -MultiViews` would be the standard hardening here (turns off
# Apache content negotiation), but OpenEMR's Apache config grants only
# `AllowOverride FileInfo`, which doesn't permit the `Options` directive.
# Setting it via .htaccess returns HTTP 500. Skipping it is fine — our
# explicit rewrite rules below already handle every legitimate request,
# and the only ambiguity MultiViews could introduce is a same-name
# extensionless filename, which we don't ship.
RewriteEngine On
RewriteBase /dashboard-app/

# Don't rewrite real files or directories — let Apache serve them
# directly (assets, favicon, fonts, .well-known, etc.).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Everything else falls back to index.html (SPA routing).
RewriteRule ^ index.html [L]
