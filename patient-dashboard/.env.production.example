# Build-time env values for the patient-dashboard production build.
#
# Copy to `.env.production` and fill in the real OAuth client_id /
# client_secret + droplet host. `.env.production` is gitignored —
# never commit OAuth credentials.
#
# Vite picks up `.env.production` automatically when running `pnpm
# build` (mode = production). The values get baked into the bundle.

# OpenEMR origin. Empty in production because the SPA is co-located
# with OpenEMR under the same host (relative-path requests, no CORS).
VITE_OPENEMR_BASE_URL=

# OpenEMR site identifier. Default install uses 'default'.
VITE_OPENEMR_SITE=default

# OAuth client_id + client_secret from the production registration.
# Re-run `scripts/register-oauth-client.sh` against the droplet's
# OpenEMR (with `OPENEMR_BASE=https://<droplet-host>` exported and the
# JSON's redirect_uris updated to the prod URL) to get fresh values.
VITE_CLIENT_ID=
VITE_CLIENT_SECRET=

# OAuth redirect URIs — must EXACTLY match the values registered on
# the OpenEMR OAuth client.
VITE_REDIRECT_URI=https://<droplet-host>/patient-dashboard/callback
VITE_POST_LOGOUT_REDIRECT_URI=https://<droplet-host>/patient-dashboard/

# Public base path for the bundle's asset URLs. Must match where the
# bundle is deployed under OpenEMR's docroot. Default deploy shape per
# PATIENT_DASHBOARD_MIGRATION.md §13 is `/patient-dashboard/`.
VITE_BASE_PATH=/patient-dashboard/
