#!/usr/bin/env bash
#
# Pre-commit hook — runs the agent's unit tests + smoke-tier eval cases
# before every commit lands. Cheap-and-fast (fixture mode, smoke tier
# only, no LLM cost, ~5-10s) so it's tolerable on every commit. Live-LLM,
# live-DB, and full/nightly tiers are intentionally skipped here (they
# cost tokens or require a running DB stack); run the wider suites
# manually before tagging a release.
#
# Install once per clone:
#     git config core.hooksPath scripts/git-hooks
#
# Skip in an emergency:
#     git commit --no-verify   (use sparingly — defeats the safety net)
#
# Run the full fixture-mode suite (smoke + full tiers, ~9 cases):
#     python -m pytest agent/tests/eval/
#
# Run a specific tier via the CLI runner:
#     python -m agent.tests.eval.runner --tier=smoke
#     python -m agent.tests.eval.runner --tier=full
#     python -m agent.tests.eval.runner --tier=nightly   # requires live LLM

set -e

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

# Find the venv's python — windows path layout differs from posix.
if   [ -x "agent/venv/Scripts/python.exe" ]; then
    PY="agent/venv/Scripts/python.exe"
elif [ -x "agent/venv/bin/python" ]; then
    PY="agent/venv/bin/python"
else
    echo "[pre-commit] agent/venv not found; skipping eval suite." >&2
    echo "[pre-commit] Set up the venv (see agent/README.md) to enable." >&2
    exit 0
fi

# Sentinel patient-ID guard -- eval case YAMLs must use sentinel IDs (999000-999999)
# or the documented fixture IDs (1=Maria, 92=Guadalupe). Reject everything else.
echo "[pre-commit] Checking eval case patient_ids for non-sentinel values..."
if grep -rn "^patient_id:" "$repo_root/agent/tests/eval/cases/" 2>/dev/null \
   | grep -v "patient_id: 1$" \
   | grep -v "patient_id: 92$" \
   | grep -v "patient_id: 999" \
   | grep -q "patient_id:"; then
    echo "[pre-commit] ERROR: non-sentinel patient_id in eval case YAML." >&2
    echo "[pre-commit] Allowed: patient_id 1 (Maria), 92 (Guadalupe), 999000-999999 (sentinels)." >&2
    exit 1
fi

echo "[pre-commit] Running verifier unit tests + smoke-tier eval cases..."
EVAL_TIER=smoke "$PY" -m pytest agent/tests/unit/ agent/tests/eval/ -q --tb=short

echo "[pre-commit] All checks passed."
