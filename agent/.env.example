# Copy to `.env` and fill in real values. `.env` is gitignored.

# ===== LLM provider =====
# Default is direct Anthropic. For development before the real key arrives,
# point at OpenRouter (set ANTHROPIC_BASE_URL=https://openrouter.ai/api
# — note NO trailing /v1; the Anthropic SDK appends /v1/messages itself
# so a /v1 in the base URL produces a doubled /v1/v1/messages path) and
# ANTHROPIC_API_KEY to your OpenRouter key. Prompt-cache behavior may
# differ from direct Anthropic.
# Model names on OpenRouter use the anthropic/<model> prefix (e.g.
# anthropic/claude-sonnet-4.5, anthropic/claude-haiku-4.5).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Models (override if testing alternative tiers)
ANTHROPIC_MODEL_REASONING=claude-sonnet-4-6
ANTHROPIC_MODEL_WORKHORSE=claude-haiku-4-5

# ===== Observability — Langfuse cloud =====
# Get keys from https://cloud.langfuse.com -> project settings.
# LANGFUSE_HOST should be the regional URL shown in your Langfuse project
# (e.g. https://us.cloud.langfuse.com or https://cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ===== Database — local dev-easy MariaDB =====
# Defaults match docker/development-easy/docker-compose.yml (port 8320 on host).
# When deploying to droplet, override these via the deployed .env.
AGENT_DB_HOST=localhost
AGENT_DB_PORT=8320
AGENT_DB_USER=openemr
AGENT_DB_PASS=openemr
AGENT_DB_NAME=openemr

# Audit-log writer credentials. Per AUDIT.md C-1, the agent maintains
# its own PHI-access audit trail in the agent_log table (designed in
# ARCHITECTURE.md §4.2). The writer uses a dedicated DB user with
# INSERT-only privileges — separate from AGENT_DB_USER (which is
# SELECT-only for clinical-data reads).
#
# Schema + DB-user provisioning live as inline heredocs in
# .deploy/bootstrap.sh (search "agent_log" there). To set up a local
# dev DB by hand, paste the CREATE TABLE + GRANT blocks from that file
# into:
#   docker compose exec -T mysql mariadb -uroot -proot openemr
#
# Production bootstrap (.deploy/bootstrap.sh) handles this automatically.
# Leave both empty to disable audit writes (no-op + one-time stderr
# warning) for local dev iteration before grants are applied.
AGENT_DB_AUDIT_USER=
AGENT_DB_AUDIT_PASS=

# ===== OpenEMR <-> agent integrity =====
# Shared HMAC secret so the agent can verify the request originated from the
# OpenEMR integration module. Generate with: `openssl rand -hex 32`.
OPENEMR_HMAC_SECRET=

# ===== Abuse resistance — per-user, post-HMAC =====
# Per-user request rate (rolling minute) and token-budget ceiling
# (rolling hour). Both default to permissive values that real clinical
# workflows should never hit; pathological loops or compromised
# sessions get rejected cleanly. Closes the production blockers
# flagged by `agent-review` (no cost ceiling) and `ai-security-review`
# (no identity-based rate limiting). State is in-process — fine for
# single-VPS week-1; Redis-backed swap when multi-replica.
AGENT_RATE_LIMIT_RPM=60
AGENT_TOKEN_BUDGET_PER_HOUR=200000

# ===== FastAPI service =====
AGENT_HOST=0.0.0.0
AGENT_PORT=8000
AGENT_LOG_LEVEL=info
