# logs
/logs

# environment vars
.env

# Database dumps and OpenEMR sites tarballs — sensitive (PHI in dumps,
# encryption drive keys in sites tarballs). Never commit. One-off
# artifacts from the local→droplet deploy dance.
*.sql
oe_sites*.tar.gz
openemr*.sql
openemr*.tar.gz

# vendor and assets
node_modules
/vendor/*
/public/assets/*
/public/themes/*
!/public/assets/modified
/.docs/.out/*

# ccda service build
ccdaservice/node_modules

# dev editor configs
/.idea/*
/.vscode/*
/.vscode-oss/*
/nbproject/*
.DS_Store
.buildpath
.project
.settings

# testing
.phpunit.result.cache

# dev tool local overrides
phpcs.xml
phpstan.neon
coverage/js-unit

# phpstan
tmp-phpstan/*

# easy dev worktree support
.worktrees.json
docker/development-easy/docker-compose.override.yml
docker/development-easy-light/docker-compose.override.yml
docker/development-easy-redis/docker-compose.override.yml

# GauntletAI project notes (local only, not for upstream)
/.gauntlet/

# Deployment scripts are tracked so the droplet can `git pull` fresh
# bootstrap. Secrets generate at runtime in /opt/agentforge/.env (which
# stays out via the universal `.env` rule above).

# Claude Code session state (local only)
/.claude/
